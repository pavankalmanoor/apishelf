{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APIShelf API Entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "category",
    "website",
    "docs_url",
    "auth_type",
    "pricing_tier",
    "https",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable slug used in URLs and as primary key"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 10 },
    "category": { "type": "string" },
    "subcategory": { "type": ["string", "null"] },
    "website": { "type": "string", "format": "uri" },
    "docs_url": { "type": "string", "format": "uri" },
    "signup_url": { "type": ["string", "null"], "format": "uri" },
    "base_url": { "type": "string", "format": "uri" },
    "example_endpoint": { "type": "string" },
    "auth_type": {
      "type": "string",
      "enum": ["none", "api_key", "oauth", "other"]
    },
    "pricing_tier": {
      "type": "string",
      "enum": ["truly_free", "free_with_signup", "free_tier_limited", "freemium"]
    },
    "rate_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_minute": { "type": ["integer", "null"] },
        "per_day": { "type": ["integer", "null"] },
        "per_month": { "type": ["integer", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "requires_credit_card": { "type": "boolean" },
    "https": { "type": "boolean" },
    "cors": { "type": "boolean" },
    "code_examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curl", "javascript", "python"],
      "properties": {
        "curl": { "type": ["string", "null"] },
        "javascript": { "type": ["string", "null"] },
        "python": { "type": ["string", "null"] }
      }
    },
    "example_response": { "type": ["string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "popularity_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gotchas": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "description": "Legacy form — treated as severity=info" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "text"],
            "properties": {
              "severity": { "type": "string", "enum": ["info", "warning"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "health_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "method", "expected_status"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "method": { "type": "string", "enum": ["GET", "POST", "HEAD"] },
        "expected_status": { "type": "integer" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "requires_auth": { "type": "boolean" }
      }
    },
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified": { "type": "boolean" },
        "last_verified": { "type": ["string", "null"], "format": "date" },
        "health_status": {
          "type": ["string", "null"],
          "enum": ["up", "down", "degraded", "unknown", null]
        },
        "uptime_percentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "cors_verified": { "type": ["boolean", "null"] },
        "verified_by": { "type": ["string", "null"] }
      }
    }
  }
}
